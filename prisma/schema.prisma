// Prisma schema for Torrent Aggregator
// SQLite for portability; switch provider to postgresql for production scale

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────

/// The owner of everything in the database.
///
/// TorrentFlow is local and single-user, so exactly one row exists (id
/// "local", created by ensureLocalUser). The relations are kept so real user
/// management can be reintroduced without migrating every table.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchList          WatchListItem[]
  clientSettings     ClientSettings?
  downloadHistory    DownloadHistory[]
  autoRules          AutoRule[]
  grabJobs           GrabJob[]
  engineTorrents     EngineTorrent[]
  playbackProgress   PlaybackProgress[]
  acquisitionTargets AcquisitionTarget[]
}

// ─── App domain models ───────────────────────────────────────────────────────

/// Canonical logical media identity. User state points here; torrents and file
/// names are physical inventory and may only bootstrap a missing legacy link.
model Work {
  id             String   @id @default(cuid())
  workKey        String   @unique
  canonicalTitle String
  year           Int?
  mediaType      String
  aliasesJson    String?
  provider       String?
  providerId     String?
  posterUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  watchListItems     WatchListItem[]
  engineTorrents     EngineTorrent[]
  acquisitionTargets AcquisitionTarget[]
  catalogEntries     CatalogEntry[]
  downloadHistory    DownloadHistory[]
  playbackProgress   PlaybackProgress[]

  @@unique([provider, providerId, mediaType])
  @@index([mediaType])
}

model WatchListItem {
  id                  String    @id @default(cuid())
  userId              String
  workId              String?
  mediaType           String // anime | movie | tv
  externalId          String // AniList id or TMDB id
  title               String
  posterUrl           String?
  synopsis            String?
  rating              Float?
  status              String    @default("watching") // watching | planned | completed | dropped
  /// When true, automation hunts next episode / release for this item
  monitored           Boolean   @default(true)
  lastChecked         DateTime  @default(now())
  lastEpisode         String? // e.g. "S01E05" — last successfully grabbed
  /// Library aggregator: user starts monitoring from this season (TV/anime)
  fromSeason          Int?
  fromEpisode         Int?      @default(1)
  /// Next episode automation / Download next should hunt (not rewound by off-cursor rewatch)
  cursorSeason        Int?
  cursorEpisode       Int?
  /// Consecutive hunts that found nothing. Drives season rollover for series,
  /// and hunt backoff for every item (see huntBackoffMs in library/cursor.ts).
  /// Reset to 0 by a successful grab.
  cursorMisses        Int       @default(0)
  /// First time the current cursor episode was skipped for a thin swarm.
  /// Drives the "waited long enough, take what we can get" escape hatch so a
  /// low-seeder-but-alive release is not deferred forever. Cleared on grab/miss.
  seederWaitSince     DateTime?
  /// ongoing | catchup | on_demand
  monitorMode         String    @default("ongoing")
  /// Resolution this title should be hunted at, overriding the global
  /// ClientSettings preference. Null means "whatever the global setting is",
  /// and is not the same as storing the global value here: a copy taken at add
  /// time would silently stop tracking the setting it was copied from.
  ///
  /// Per title rather than global because the tradeoff is per title. A film
  /// watched once on a projector and a 500-episode show watched on a laptop
  /// want different answers, and a single global number forces the user to
  /// keep changing it or accept the wrong one for one of them.
  preferredResolution Int?
  latestReleaseTitle  String?
  latestReleaseAt     DateTime?
  latestReleaseMagnet String?
  nextEpisodeHint     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([userId, mediaType, externalId])
  @@index([userId])
  @@index([workId])
}

/// Automation grab attempt (rules / library hunt / manual)
model GrabJob {
  id         String   @id @default(cuid())
  userId     String
  title      String
  query      String
  status     String // queued | searching | sent | failed | skipped
  message    String?
  magnet     String?
  infoHash   String?
  source     String?
  savePath   String?
  category   String?
  kind       String? // rule | library | manual
  externalId String? // watchlist item id or rule id
  /// Acquisition intent: "keep" (explicit download) | "stream" (ephemeral
  /// playback cache) | "prewarm" (speculative). Nullable/additive: legacy rows
  /// predate the column and read as an ordinary download. Lets Activity avoid
  /// listing an ephemeral Play as a user download.
  retention  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

model CachedMetadata {
  id          String    @id @default(cuid())
  cacheKey    String    @unique
  source      String // anilist | tmdb
  mediaType   String // anime | movie | tv
  externalId  String
  title       String
  posterUrl   String?
  backdropUrl String?
  synopsis    String?
  rating      Float?
  year        Int?
  /// Primary release date (movie) or first-air date (tv/anime). Null = unknown.
  /// Drives future-gating: a title whose releaseDate is in the future is shown
  /// grayed + "Coming {date}", never as a dead play/download action.
  releaseDate DateTime?
  genres      String?
  rawJson     String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([source, externalId])
  @@index([expiresAt])
  @@index([updatedAt])
}

model ClientSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  /// Active download client for Send + Client page. Default: builtin (one-app).
  /// qbittorrent | transmission only if user deliberately makes external primary.
  clientType                String   @default("builtin")
  /// Optional secondary client for "Send / move to my client" while primary stays builtin.
  /// qbittorrent | transmission | null. host/username/password apply to this when set.
  externalClientType        String?
  host                      String   @default("http://127.0.0.1:8080")
  username                  String?
  password                  String? // AES-GCM encrypted when ENCRYPTION_KEY / AUTH_SECRET present
  category                  String? // default category / label applied on send
  savePath                  String? // default download directory
  /// Base folder; when set, missing pathRules resolve to base/Category
  baseDownloadPath          String?
  /// Cap on total size under baseDownloadPath (bytes). Null = unset.
  /// Downloads are refused until the user explicitly configures this value.
  maxStorageBytes           BigInt?
  /// True only after the user explicitly saves a positive storage cap.
  /// Null marks legacy guessed defaults as unconfigured.
  storageCapConfigured      Boolean?
  /// Enables additional playback diagnostics. Null is treated as false.
  verboseDiagnostics        Boolean?
  /// Minimum vertical resolution for kept downloads (e.g. 1080).
  /// Null = 1080p default. Lower and unknown resolutions are never dispatched;
  /// higher resolutions remain eligible when the minimum is unavailable.
  preferredResolution       Int?
  /// Minutes between automatic automation runs. Null or 0 = never run on a
  /// timer (automation only fires when the user asks for it). Opt-in on
  /// purpose: a background timer that grabs releases is not something to
  /// switch on behind the user's back.
  automationIntervalMinutes Int?
  /// Default retention for new built-in primary sends: "EPHEMERAL" (stream-only) | "KEPT".
  /// Tracked/watchlisted/explicit keep sends are promoted to KEPT regardless of this default.
  defaultRetentionPolicy    String   @default("EPHEMERAL")
  /// Speculative swarm-probe scope: "off" | "watching" | "monitored".
  /// Null = the "watching" default (only the next episode of shows in
  /// progress). Unlike automation this only *measures* swarm health, it never
  /// grabs, so a non-off default is safe — but "everything" is deliberately not
  /// an option: probing the whole catalogue is bandwidth spent competing with
  /// playback for content nobody will open.
  preProbeScope             String?
  /// JSON string[] — quick-pick category chips in UI
  categories                String?
  /// JSON Record<string,string> — category name → download folder
  pathRules                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Durable state for the built-in BitTorrent engine (survives process restart).
model EngineTorrent {
  id                String    @id @default(cuid())
  userId            String
  workId            String?
  hash              String
  name              String
  magnet            String?
  torrentUrl        String?
  savePath          String?
  category          String?
  status            String    @default("downloading") // downloading | queued | downloaded | paused | error | removed
  progress          Float     @default(0)
  sizeBytes         BigInt    @default(0)
  verifiedBitfield  String?
  verifiedFilesJson String?
  verifiedAt        DateTime?
  error             String?
  /// Who asked for this: "user" (explicit grab/kept) | "stream" (ephemeral
  /// playback cache) | "prewarm" (speculative). Only cache origins may be
  /// evicted, and stream eviction has its own playback/grace/watchlist guards.
  origin            String    @default("user")
  /// Eviction lease token, set atomically when a sweep claims this row
  /// (origin → "evicting"). Format "<claimedAtMs>:<uuid>". NULL when unleased.
  /// An explicit user add clears it when it STEALS the lease; a stale lease
  /// (crash between claim and delete) is recovered by age. Additive/nullable —
  /// existing rows are NULL and are never touched.
  evictLease        String?
  /// The origin to restore if a lease is recovered (never inferred — it is the
  /// exact value recorded at claim time). NULL when unleased.
  evictFrom         String?
  /// Last time playback touched this torrent. Drives LRU eviction of caches.
  lastUsedAt        DateTime  @default(now())
  /// Sortable position inside this work's download queue ("s00001e00002").
  /// NULL for anything without an episode position (films, one-offs), which
  /// sorts after the numbered rows of its group. See lib/clients/download-queue.
  queueKey          String?
  /// Set when the owner pressed Download now on a queued item. A forced row
  /// starts immediately and is never held back by the active-download cap,
  /// including across a restart. Cleared when the transfer ends.
  forcedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([userId, hash])
  @@index([userId, status])
  @@index([userId, origin, lastUsedAt])
  @@index([workId])
}

/// Durable user acquisition intent. Unlike EngineTorrent, this row identifies
/// the exact title/season/episode the user asked for. A torrent may satisfy
/// several files, but its aggregate progress must only update the target that
/// explicitly links to it.
model AcquisitionTarget {
  id                  String   @id @default(cuid())
  userId              String
  workId              String?
  targetKey           String
  workKey             String
  scope               String
  season              Int?
  episode             Int?
  preferredResolution Int?
  status              String   @default("queued") // queued | downloading | downloaded | failed
  progress            Float    @default(0)
  infoHash            String?
  filePath            String?
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([userId, targetKey])
  @@index([userId, workKey, scope])
  @@index([userId, infoHash])
  @@index([userId, status])
  @@index([workId])
}

/// A discovered title, independent of any release. This is the catalog layer
/// the browse page reads: rails must never resolve a torrent on render, so
/// trending/popular titles are cached here and refreshed on a timer.
model CatalogEntry {
  id          String    @id @default(cuid())
  workId      String?
  /// Stable key derived from the work identity (normalised title + year).
  workKey     String
  title       String
  year        Int?
  /// Primary release / first-air date; drives future-gating (gray + "Coming").
  releaseDate DateTime?
  mediaType   String // movie | tv | anime
  posterUrl   String?
  backdropUrl String?
  overview    String?
  rating      Float?
  /// Which rail sourced this: "trending" | "popular" | "related".
  source      String
  /// Ordering within its source, lowest first.
  rank        Int       @default(0)
  /// Free-form seed for "Because you're watching X".
  seedTitle   String?
  /// Highest seeder count seen for this title, for a health hint pre-click.
  seeders     Int       @default(0)
  /// The best release name found, so the detail page can pre-rank instantly.
  bestRelease String?
  refreshedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([workKey, source, seedTitle])
  @@index([source, rank])
  // The read path orders by rank, then title. Keeping title in the index avoids
  // SQLite building a temp B-tree for the right side of that ORDER BY.
  @@index([source, seedTitle, rank, title])
  @@index([refreshedAt])
  @@index([workId])
}

model DownloadHistory {
  id         String   @id @default(cuid())
  userId     String
  workId     String?
  title      String
  magnet     String?
  torrentUrl String?
  infoHash   String?
  source     String?
  status     String // sent | failed
  message    String?
  context    String?
  category   String?
  savePath   String?
  clientType String?
  sendKind   String?
  /// Acquisition intent: "keep" | "stream" | "prewarm". Nullable/additive:
  /// legacy rows predate the column and read as an ordinary download. The
  /// Recently Added rail and download log filter out "stream" so an ephemeral
  /// Play is never surfaced as something the user chose to download.
  retention  String?
  createdAt  DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([workId])
}

model AutoRule {
  id              String    @id @default(cuid())
  userId          String
  name            String
  query           String
  category        String    @default("all")
  minSeeders      Int       @default(10)
  maxSizeBytes    BigInt?
  resolution      String? // 1080p | 720p | 2160p
  sources         String? // comma-separated source ids
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  lastMatchTitle  String?
  lastMatchMagnet String?
  matchCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

/// Guards against concurrent automation/rules runs double-grabbing the same release.
model RunLock {
  id         String   @id @default(cuid())
  userId     String
  scope      String // automation | rules
  acquiredAt DateTime @default(now())

  @@unique([userId, scope])
  /// Stale-lock reclamation scans by age (acquiredAt < cutoff); without this it
  /// is a full table scan on every automation run.
  @@index([acquiredAt])
}

/// Where the user is inside a specific playable file.
///
/// Keyed by the file rather than the title because one torrent can hold a whole
/// season, and "resume" has to mean the episode actually being watched. The
/// title/season/episode/poster columns are denormalised on purpose: Continue
/// Watching is the first rail on the home page, and it must render without
/// waking the torrent engine or re-parsing release names on every load.
model PlaybackProgress {
  id              String    @id @default(cuid())
  userId          String
  workId          String?
  infoHash        String
  filePath        String
  positionSec     Float     @default(0)
  durationSec     Float?
  /// Set once playback passes the completion threshold. Completion is judged on
  /// a fraction of duration, never on reaching the exact end, because viewers
  /// routinely abandon a file during the credits and would otherwise keep a
  /// finished episode pinned to Continue Watching forever.
  completedAt     DateTime?
  title           String
  season          Int?
  episode         Int?
  watchListItemId String?
  posterUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@unique([userId, infoHash, filePath])
  @@index([userId, updatedAt])
  @@index([userId, completedAt])
  @@index([workId])
}

/// Cached ffprobe result for one file inside one torrent.
///
/// Probing costs a seek to the head of the file, which on a cold torrent means
/// waiting for real pieces to arrive, so the answer is remembered. The stored
/// fields are exactly what the playback decision needs: container and codecs
/// decide direct-play vs remux vs transcode, and channel layout is kept so a
/// 5.1 track is never silently downmixed to stereo.
model MediaProbe {
  id            String   @id @default(cuid())
  infoHash      String
  filePath      String
  container     String?
  durationSec   Float?
  videoCodec    String?
  videoProfile  String?
  width         Int?
  height        Int?
  /// e.g. smpte2084 (HDR10) / arib-std-b67 (HLG); null or bt709 means SDR.
  colorTransfer String?
  audioCodec    String?
  audioChannels Int?
  audioLayout   String?
  /// Measured source bitrate in bits/sec (video stream rate, else the container
  /// rate). Nullable: null means ffprobe reported none, or the row predates this
  /// column — never a guess. Cached so common MKVs, whose bitrate lives only on
  /// the container, keep bitrate-aware buffer sizing after the first cold probe.
  bitRateBps    Int?
  /// Which generation of the probe cache wrote this row. Rows written before a
  /// field existed carry a lower version and are treated as a one-shot miss, so
  /// they re-probe exactly once instead of serving a permanently degraded
  /// answer. A freshly written row is always current, so a file whose ffprobe
  /// genuinely reports no bitrate is cached as "unknown" and never re-probed.
  probeVersion  Int      @default(0)
  /// JSON: the full stream list, so subtitle/audio track pickers do not need a
  /// second probe.
  streamsJson   String?
  probedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([infoHash, filePath])
}

/// A *measured* verdict on whether a swarm can actually feed a stream.
///
/// Advertised seeder counts are a claim from the indexer, and that claim does
/// not survive contact with the swarm (28 advertised → 6 connected → 0
/// delivering, observed live). `swarmProbe` briefly attaches to the swarm and
/// records what it *actually* delivered; this table remembers that so we do not
/// re-probe the same magnet on every play or speculation.
///
/// Keyed by infoHash (normalised lowercase hex) because the swarm is a property
/// of the content, not of any one search or user.
///
/// `verdict` is one of good | weak | dead | unknown. **`unknown` is not
/// `dead`** — see `swarm-probe.ts` and the `availability: null` discussion in
/// docs/handover.md §3. An expired row must read as `unknown`, never as its
/// last verdict, so a swarm that has since revived gets a fresh chance.
model SwarmMeasurement {
  id             String   @id @default(cuid())
  /// 40-char lowercase-hex infoHash. Normalised before write (see infohash.ts).
  infoHash       String   @unique
  /// Human-readable release name for the settings visibility list, best-effort
  /// from the magnet `dn` or the candidate title. Nullable: a probe still
  /// records its measurement even when no name was resolvable.
  name           String?
  /// Peers that actually connected — not the number advertised.
  peersConnected Int      @default(0)
  /// Of those, how many actually sent us bytes. A peer that connects and chokes
  /// us forever is worth nothing, so it is counted separately.
  peersUnchoked  Int      @default(0)
  /// Total content bytes received during the probe window.
  bytesReceived  BigInt   @default(0)
  /// How long the probe ran, in milliseconds.
  elapsedMs      Int      @default(0)
  /// Derived effective throughput: bytesReceived / elapsed, in bytes/sec.
  effectiveBps   Float    @default(0)
  /// The bitrate the file needs to sustain playback, in bytes/sec, that the
  /// verdict was judged against (from size+duration, or the named fallback).
  requiredBps    Float    @default(0)
  verdict        String
  measuredAt     DateTime @default(now())
  /// When this verdict stops being trusted. A read past this reports `unknown`.
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

model SearchCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique
  /// normalizeTitle() of the query this row answered.
  ///
  /// The browse availability resolver needs "the most recent search for this
  /// title", but `cacheKey` is an opaque sha256 over the *full* option set
  /// (category, limit, sources, filters, target resolution). Any caller with a
  /// different option shape produces a different hash, so reconstructing the
  /// key from the outside is a guaranteed miss that no test can catch — and
  /// adding one option (as `target` was) silently breaks it again. Keying the
  /// lookup off the query itself is stable under all of that.
  ///
  /// Nullable so pre-existing rows need no backfill; they simply age out.
  normalizedQuery String?
  payload         String // JSON SearchResponse
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([normalizedQuery, expiresAt])
}
