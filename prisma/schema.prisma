// Prisma schema for Torrent Aggregator
// SQLite for portability; switch provider to postgresql for production scale

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────

/// The owner of everything in the database.
///
/// TorrentFlow is local and single-user, so exactly one row exists (id
/// "local", created by ensureLocalUser). The relations are kept so real user
/// management can be reintroduced without migrating every table.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchList      WatchListItem[]
  clientSettings ClientSettings?
  downloadHistory DownloadHistory[]
  autoRules      AutoRule[]
  grabJobs       GrabJob[]
  engineTorrents EngineTorrent[]
  playbackProgress PlaybackProgress[]
}

// ─── App domain models ───────────────────────────────────────────────────────

model WatchListItem {
  id                  String    @id @default(cuid())
  userId              String
  mediaType           String // anime | movie | tv
  externalId          String // AniList id or TMDB id
  title               String
  posterUrl           String?
  synopsis            String?
  rating              Float?
  status              String    @default("watching") // watching | planned | completed | dropped
  /// When true, automation hunts next episode / release for this item
  monitored           Boolean   @default(true)
  lastChecked         DateTime  @default(now())
  lastEpisode         String? // e.g. "S01E05" — last successfully grabbed
  /// Library aggregator: user starts monitoring from this season (TV/anime)
  fromSeason          Int?
  fromEpisode         Int?      @default(1)
  /// Next episode automation / Download next should hunt (not rewound by off-cursor rewatch)
  cursorSeason        Int?
  cursorEpisode       Int?
  /// Consecutive hunts that found nothing. Drives season rollover for series,
  /// and hunt backoff for every item (see huntBackoffMs in library/cursor.ts).
  /// Reset to 0 by a successful grab.
  cursorMisses        Int       @default(0)
  /// First time the current cursor episode was skipped for a thin swarm.
  /// Drives the "waited long enough, take what we can get" escape hatch so a
  /// low-seeder-but-alive release is not deferred forever. Cleared on grab/miss.
  seederWaitSince     DateTime?
  /// ongoing | catchup | on_demand
  monitorMode         String    @default("ongoing")
  latestReleaseTitle  String?
  latestReleaseAt     DateTime?
  latestReleaseMagnet String?
  nextEpisodeHint     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, externalId])
  @@index([userId])
}

/// Automation grab attempt (rules / library hunt / manual)
model GrabJob {
  id         String   @id @default(cuid())
  userId     String
  title      String
  query      String
  status     String // queued | searching | sent | failed | skipped
  message    String?
  magnet     String?
  infoHash   String?
  source     String?
  savePath   String?
  category   String?
  kind       String? // rule | library | manual
  externalId String? // watchlist item id or rule id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

model CachedMetadata {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  source      String // anilist | tmdb
  mediaType   String // anime | movie | tv
  externalId  String
  title       String
  posterUrl   String?
  backdropUrl String?
  synopsis    String?
  rating      Float?
  year        Int?
  genres      String?
  rawJson     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, externalId])
  @@index([expiresAt])
}

model ClientSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// Active download client for Send + Client page. Default: builtin (one-app).
  /// qbittorrent | transmission only if user deliberately makes external primary.
  clientType String   @default("builtin")
  /// Optional secondary client for "Send / move to my client" while primary stays builtin.
  /// qbittorrent | transmission | null. host/username/password apply to this when set.
  externalClientType String?
  host       String   @default("http://127.0.0.1:8080")
  username   String?
  password   String? // AES-GCM encrypted when ENCRYPTION_KEY / AUTH_SECRET present
  category   String? // default category / label applied on send
  savePath   String? // default download directory
  /// Base folder; when set, missing pathRules resolve to base/Category
  baseDownloadPath String?
  /// Cap on total size under baseDownloadPath (bytes). Null = default 100GB cap.
  /// Enforced automatically on every send / automation / on-demand grab.
  maxStorageBytes BigInt?
  /// Target vertical resolution for ranking (e.g. 1080). Null = 1080p default.
  /// This is a *target*, not a floor: releases are ordered by closeness to it,
  /// below-target degrading gracefully and above-target sinking below all of
  /// them. Nothing is ever rejected for resolution, so raising or lowering this
  /// can never starve a monitored show. See docs/architecture/release-ranking.md
  preferredResolution Int?
  /// Minutes between automatic automation runs. Null or 0 = never run on a
  /// timer (automation only fires when the user asks for it). Opt-in on
  /// purpose: a background timer that grabs releases is not something to
  /// switch on behind the user's back.
  automationIntervalMinutes Int?
  /// JSON string[] — quick-pick category chips in UI
  categories String?
  /// JSON Record<string,string> — category name → download folder
  pathRules  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Durable state for the built-in BitTorrent engine (survives process restart).
model EngineTorrent {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  name      String
  magnet    String?
  savePath  String?
  category  String?
  status    String   @default("downloading") // downloading | seeding | paused | error | removed
  progress  Float    @default(0)
  sizeBytes BigInt   @default(0)
  error     String?
  /// Who asked for this: "user" (explicit grab) | "prewarm" (speculative).
  /// Only `prewarm` rows may be evicted to reclaim disk — evicting something
  /// the user explicitly asked for would be data loss, not cache management.
  origin    String   @default("user")
  /// Last time playback touched this torrent. Drives LRU eviction of prewarms.
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([userId, status])
  @@index([userId, origin, lastUsedAt])
}

/// A discovered title, independent of any release. This is the catalog layer
/// the browse page reads: rails must never resolve a torrent on render, so
/// trending/popular titles are cached here and refreshed on a timer.
model CatalogEntry {
  id          String   @id @default(cuid())
  /// Stable key derived from the work identity (normalised title + year).
  workKey     String
  title       String
  year        Int?
  mediaType   String // movie | tv | anime
  posterUrl   String?
  backdropUrl String?
  overview    String?
  rating      Float?
  /// Which rail sourced this: "trending" | "popular" | "related".
  source      String
  /// Ordering within its source, lowest first.
  rank        Int      @default(0)
  /// Free-form seed for "Because you're watching X".
  seedTitle   String?
  /// Highest seeder count seen for this title, for a health hint pre-click.
  seeders     Int      @default(0)
  /// The best release name found, so the detail page can pre-rank instantly.
  bestRelease String?
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([workKey, source, seedTitle])
  @@index([source, rank])
  @@index([refreshedAt])
}

model DownloadHistory {
  id         String   @id @default(cuid())
  userId     String
  title      String
  magnet     String?
  torrentUrl String?
  infoHash   String?
  source     String?
  status     String // sent | failed
  message    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

model AutoRule {
  id              String    @id @default(cuid())
  userId          String
  name            String
  query           String
  category        String    @default("all")
  minSeeders      Int       @default(10)
  maxSizeBytes    BigInt?
  resolution      String? // 1080p | 720p | 2160p
  sources         String? // comma-separated source ids
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  lastMatchTitle  String?
  lastMatchMagnet String?
  matchCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

/// Guards against concurrent automation/rules runs double-grabbing the same release.
model RunLock {
  id         String   @id @default(cuid())
  userId     String
  scope      String // automation | rules
  acquiredAt DateTime @default(now())

  @@unique([userId, scope])
  /// Stale-lock reclamation scans by age (acquiredAt < cutoff); without this it
  /// is a full table scan on every automation run.
  @@index([acquiredAt])
}

/// Where the user is inside a specific playable file.
///
/// Keyed by the file rather than the title because one torrent can hold a whole
/// season, and "resume" has to mean the episode actually being watched. The
/// title/season/episode/poster columns are denormalised on purpose: Continue
/// Watching is the first rail on the home page, and it must render without
/// waking the torrent engine or re-parsing release names on every load.
model PlaybackProgress {
  id              String    @id @default(cuid())
  userId          String
  infoHash        String
  filePath        String
  positionSec     Float     @default(0)
  durationSec     Float?
  /// Set once playback passes the completion threshold. Completion is judged on
  /// a fraction of duration, never on reaching the exact end, because viewers
  /// routinely abandon a file during the credits and would otherwise keep a
  /// finished episode pinned to Continue Watching forever.
  completedAt     DateTime?
  title           String
  season          Int?
  episode         Int?
  watchListItemId String?
  posterUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, infoHash, filePath])
  @@index([userId, updatedAt])
  @@index([userId, completedAt])
}

/// Cached ffprobe result for one file inside one torrent.
///
/// Probing costs a seek to the head of the file, which on a cold torrent means
/// waiting for real pieces to arrive, so the answer is remembered. The stored
/// fields are exactly what the playback decision needs: container and codecs
/// decide direct-play vs remux vs transcode, and channel layout is kept so a
/// 5.1 track is never silently downmixed to stereo.
model MediaProbe {
  id            String   @id @default(cuid())
  infoHash      String
  filePath      String
  container     String?
  durationSec   Float?
  videoCodec    String?
  videoProfile  String?
  width         Int?
  height        Int?
  /// e.g. smpte2084 (HDR10) / arib-std-b67 (HLG); null or bt709 means SDR.
  colorTransfer String?
  audioCodec    String?
  audioChannels Int?
  audioLayout   String?
  /// JSON: the full stream list, so subtitle/audio track pickers do not need a
  /// second probe.
  streamsJson   String?
  probedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([infoHash, filePath])
}

model SearchCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  /// normalizeTitle() of the query this row answered.
  ///
  /// The browse availability resolver needs "the most recent search for this
  /// title", but `cacheKey` is an opaque sha256 over the *full* option set
  /// (category, limit, sources, filters, target resolution). Any caller with a
  /// different option shape produces a different hash, so reconstructing the
  /// key from the outside is a guaranteed miss that no test can catch — and
  /// adding one option (as `target` was) silently breaks it again. Keying the
  /// lookup off the query itself is stable under all of that.
  ///
  /// Nullable so pre-existing rows need no backfill; they simply age out.
  normalizedQuery String?
  payload   String // JSON SearchResponse
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([normalizedQuery, expiresAt])
}
