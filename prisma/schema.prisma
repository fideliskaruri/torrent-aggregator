// Prisma schema for Torrent Aggregator
// SQLite for portability; switch provider to postgresql for production scale

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────

/// The owner of everything in the database.
///
/// TorrentFlow is local and single-user, so exactly one row exists (id
/// "local", created by ensureLocalUser). The relations are kept so real user
/// management can be reintroduced without migrating every table.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchList      WatchListItem[]
  clientSettings ClientSettings?
  downloadHistory DownloadHistory[]
  autoRules      AutoRule[]
  grabJobs       GrabJob[]
  engineTorrents EngineTorrent[]
}

// ─── App domain models ───────────────────────────────────────────────────────

model WatchListItem {
  id                  String    @id @default(cuid())
  userId              String
  mediaType           String // anime | movie | tv
  externalId          String // AniList id or TMDB id
  title               String
  posterUrl           String?
  synopsis            String?
  rating              Float?
  status              String    @default("watching") // watching | planned | completed | dropped
  /// When true, automation hunts next episode / release for this item
  monitored           Boolean   @default(true)
  lastChecked         DateTime  @default(now())
  lastEpisode         String? // e.g. "S01E05" — last successfully grabbed
  /// Library aggregator: user starts monitoring from this season (TV/anime)
  fromSeason          Int?
  fromEpisode         Int?      @default(1)
  /// Next episode automation / Download next should hunt (not rewound by off-cursor rewatch)
  cursorSeason        Int?
  cursorEpisode       Int?
  /// Consecutive hunts that found nothing — drives season rollover
  cursorMisses        Int       @default(0)
  /// First time the current cursor episode was skipped for a thin swarm.
  /// Drives the "waited long enough, take what we can get" escape hatch so a
  /// low-seeder-but-alive release is not deferred forever. Cleared on grab/miss.
  seederWaitSince     DateTime?
  /// ongoing | catchup | on_demand
  monitorMode         String    @default("ongoing")
  latestReleaseTitle  String?
  latestReleaseAt     DateTime?
  latestReleaseMagnet String?
  nextEpisodeHint     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, externalId])
  @@index([userId])
}

/// Automation grab attempt (rules / library hunt / manual)
model GrabJob {
  id         String   @id @default(cuid())
  userId     String
  title      String
  query      String
  status     String // queued | searching | sent | failed | skipped
  message    String?
  magnet     String?
  infoHash   String?
  source     String?
  savePath   String?
  category   String?
  kind       String? // rule | library | manual
  externalId String? // watchlist item id or rule id
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

model CachedMetadata {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  source      String // anilist | tmdb
  mediaType   String // anime | movie | tv
  externalId  String
  title       String
  posterUrl   String?
  backdropUrl String?
  synopsis    String?
  rating      Float?
  year        Int?
  genres      String?
  rawJson     String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, externalId])
  @@index([expiresAt])
}

model ClientSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  /// Active download client for Send + Client page. Default: builtin (one-app).
  /// qbittorrent | transmission only if user deliberately makes external primary.
  clientType String   @default("builtin")
  /// Optional secondary client for "Send / move to my client" while primary stays builtin.
  /// qbittorrent | transmission | null. host/username/password apply to this when set.
  externalClientType String?
  host       String   @default("http://127.0.0.1:8080")
  username   String?
  password   String? // AES-GCM encrypted when ENCRYPTION_KEY / AUTH_SECRET present
  category   String? // default category / label applied on send
  savePath   String? // default download directory
  /// Base folder; when set, missing pathRules resolve to base/Category
  baseDownloadPath String?
  /// Cap on total size under baseDownloadPath (bytes). Null = default 100GB cap.
  /// Enforced automatically on every send / automation / on-demand grab.
  maxStorageBytes BigInt?
  /// Target vertical resolution for ranking (e.g. 1080). Null = 1080p default.
  /// This is a *target*, not a floor: releases are ordered by closeness to it,
  /// below-target degrading gracefully and above-target sinking below all of
  /// them. Nothing is ever rejected for resolution, so raising or lowering this
  /// can never starve a monitored show. See docs/architecture/release-ranking.md
  preferredResolution Int?
  /// Minutes between automatic automation runs. Null or 0 = never run on a
  /// timer (automation only fires when the user asks for it). Opt-in on
  /// purpose: a background timer that grabs releases is not something to
  /// switch on behind the user's back.
  automationIntervalMinutes Int?
  /// JSON string[] — quick-pick category chips in UI
  categories String?
  /// JSON Record<string,string> — category name → download folder
  pathRules  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Durable state for the built-in BitTorrent engine (survives process restart).
model EngineTorrent {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  name      String
  magnet    String?
  savePath  String?
  category  String?
  status    String   @default("downloading") // downloading | seeding | paused | error | removed
  progress  Float    @default(0)
  sizeBytes BigInt   @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([userId, status])
}

model DownloadHistory {
  id         String   @id @default(cuid())
  userId     String
  title      String
  magnet     String?
  torrentUrl String?
  infoHash   String?
  source     String?
  status     String // sent | failed
  message    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AutoRule {
  id              String    @id @default(cuid())
  userId          String
  name            String
  query           String
  category        String    @default("all")
  minSeeders      Int       @default(10)
  maxSizeBytes    BigInt?
  resolution      String? // 1080p | 720p | 2160p
  sources         String? // comma-separated source ids
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  lastMatchTitle  String?
  lastMatchMagnet String?
  matchCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

/// Guards against concurrent automation/rules runs double-grabbing the same release.
model RunLock {
  id         String   @id @default(cuid())
  userId     String
  scope      String // automation | rules
  acquiredAt DateTime @default(now())

  @@unique([userId, scope])
}

model SearchCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  payload   String // JSON SearchResponse
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
