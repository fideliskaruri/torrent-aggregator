{
  "name": "torrent-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "prisma db push && prisma generate",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:live": "node scripts/run-unit-tests.mjs --live",
    "test:api": "node scripts/api-smoke.mjs",
    "test:library": "tsx scripts/test-settings-upsert.ts && tsx scripts/test-library-hunt.ts && tsx scripts/test-ondemand-and-estimate.ts && tsx scripts/test-ondemand-advance.ts && tsx scripts/test-builtin-send.ts",
    "test:all": "node scripts/test-all.mjs",
    "test:e2e": "node scripts/playwright-e2e.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.21",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.14",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
