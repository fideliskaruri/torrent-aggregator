{
  "name": "torrent-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:prod": "node scripts/audit-production.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:backfill-works": "tsx scripts/backfill-canonical-works.mts",
    "db:studio": "prisma studio",
    "setup": "prisma db push && prisma generate",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:live": "node scripts/run-unit-tests.mjs --live",
    "test:api": "node scripts/api-smoke.mjs",
    "test:library": "tsx scripts/test-settings-upsert.ts && tsx scripts/test-library-hunt.ts && tsx scripts/test-ondemand-and-estimate.ts && tsx scripts/test-ondemand-advance.ts && tsx scripts/test-builtin-send.ts",
    "test:all": "node scripts/test-all.mjs",
    "test:ui": "node scripts/check-layout.mjs && node scripts/check-ui-fixes.mjs",
    "test:errors": "node scripts/qa-error-states.mjs",
    "test:seam": "tsx scripts/test-availability-seam.mts",
    "test:rails": "tsx scripts/test-browse-rails.mts",
    "test:browse": "node scripts/shoot-browse.mjs",
    "test:watchlist": "node scripts/shoot-watchlist.mjs",
    "test:visual": "node scripts/visual-suite.mjs",
    "test:visual:snapshots": "playwright test",
    "test": "node scripts/test-all.mjs",
    "postinstall": "prisma generate",
    "test:torrent": "tsx scripts/e2e-content-layout.mts",
    "test:media": "tsx scripts/media-ladder-e2e.mts",
    "test:media:stall": "tsx scripts/media-stall-watchdog.mts",
    "test:media:browser": "tsx scripts/media-browser-playback.mts",
    "test:media:torrent": "tsx scripts/media-torrent-e2e.mts",
    "test:media:bitrate": "tsx scripts/media-stream-bitrate.mts",
    "test:media:ui": "tsx scripts/media-player-ui.mts",
    "test:media:instant": "tsx scripts/media-instant-play-e2e.mts",
    "test:journeys": "tsx scripts/journeys/run.mts",
    "test:journeys:gate": "tsx scripts/journeys/run.mts --gate",
    "seed": "node scripts/seed-demo.mjs",
    "seed:reset": "node scripts/seed-demo.mjs --reset",
    "test:images": "tsx scripts/check-image-hosts.mts",
    "test:catalog": "tsx scripts/check-catalog-quality.mts",
    "check:sabotage": "node scripts/check-no-sabotage.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.21",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.14",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.25.0",
    "next": "16.3.0",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
