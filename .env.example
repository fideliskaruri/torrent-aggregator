# Database (SQLite — portable local default)
DATABASE_URL="file:./dev.db"

# Encrypts stored qBittorrent/Transmission passwords (AES-256-GCM).
# Optional: if unset, a key is generated on first use and saved to
# .torrentflow.key. Back that file up alongside your database.
# Generate one with: openssl rand -base64 32
# ENCRYPTION_KEY=""

# Optional TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""

# Optional: default download root (Docker uses /downloads)
# DOWNLOAD_DIR=""

# Optional overrides for torrent indexers
# NYAA_BASE_URL="https://nyaa.si"
# X1337_BASE_URL="https://1337x.to"

# Set to 1 to enable the 1337x scraper
# ENABLE_1337X="0"
