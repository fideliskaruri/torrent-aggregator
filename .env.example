# Docker Compose settings. Copy to .env; never commit real tokens.
# Optional encryption/indexer overrides (also forwarded by Compose):
# ENCRYPTION_KEY=""
# DOWNLOAD_DIR=""
# NYAA_BASE_URL="https://nyaa.si"
# X1337_BASE_URL="https://1337x.to"
# ENABLE_1337X="0"
TORRENTFLOW_TAG=latest
PUID=1000
PGID=1000
TZ=Etc/UTC
# Empty uses a named media volume; an absolute host path uses a bind mount.
MEDIA_PATH=
# Display only; editable folders and API operations always use /media paths.
# Use single quotes for Windows/UNC paths, e.g. '\\NAS\media'.
MEDIA_DISPLAY_PATH=
TMDB_API_KEY=
# Optional: docker compose --profile remote up -d
TUNNEL_TOKEN=
# Optional standalone VPN example; fill these from your VPN provider.
VPN_SERVICE_PROVIDER=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
