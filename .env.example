# Database (SQLite — portable local default)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"

# GitHub OAuth (required for sign-in)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""

# Optional overrides for torrent indexers
# NYAA_BASE_URL="https://nyaa.si"
# X1337_BASE_URL="https://1337x.to"
