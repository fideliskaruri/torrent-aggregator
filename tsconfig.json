{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-api-cap/types/**/*.ts",
    ".next-api-cap/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "web",
    "server",
    "scripts/_*.ts",
    "scripts/_*.mts",
    "scripts/_*.mjs",
    ".qabak",
    ".sessions",
    ".sessions/**",
    ".e2e-instant-play",
    ".e2e-instant-play/**",
    "downloads",
    "downloads/**",
    "qa-screens",
    "qa-screens/**",
    "qa-shots",
    "qa-shots/**",
    "snapshots",
    "snapshots/**"
  ]
}
