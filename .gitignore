# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# npm registry config (may contain private feed credentials)
.npmrc

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# database
*.db
*.db-journal
/prisma/dev.db
/dev.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local download / test artifacts
/downloads
/tmp-test-downloads
/qa-shots
tmp-home.html
*.tsbuildinfo

# agent / session scratch
.grok/
.claude/
# Throwaway probe scripts. They are excluded from tsconfig too: a scratch file
# must never be able to break `npm run build` for everyone else.
scripts/_*
.qabak/
qa-*.log

# OS
Thumbs.db
Desktop.ini

# Auto-generated credential encryption key
.torrentflow.key

# QA artifacts
qa-screens/
dev-server.log
prod-server.log

# Layout ownership manifest (which torrent owns which file on disk)
.torrentflow-layout.json

# Scratch request bodies for manual API pokes
switch.json

# local run logs
run.log
fix-server.log

# Playback transcode/remux session temp files
.sessions/

# Generated media fixtures for the playback e2e harness
.media-e2e/
