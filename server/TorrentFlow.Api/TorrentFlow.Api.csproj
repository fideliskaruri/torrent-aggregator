<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TorrentFlow.Api</RootNamespace>
    <UserSecretsId>torrentflow-local</UserSecretsId>
    <!-- Workstation GC: a 20-min soak with 5 live downloads plateaued at ~175 MB working set / ~65 MB private
         (GC committed ~35 MB) versus ~211 MB / ~108 MB (GC committed ~70 MB) under Server GC, same throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <WebProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'web'))</WebProjectDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <ProjectReference Include="..\TorrentFlow.Core\TorrentFlow.Core.csproj" />
    <ProjectReference Include="..\TorrentFlow.Data\TorrentFlow.Data.csproj" />
    <ProjectReference Include="..\TorrentFlow.Search\TorrentFlow.Search.csproj" />
    <ProjectReference Include="..\TorrentFlow.Metadata\TorrentFlow.Metadata.csproj" />
    <ProjectReference Include="..\TorrentFlow.Engine\TorrentFlow.Engine.csproj" />
    <ProjectReference Include="..\TorrentFlow.Library\TorrentFlow.Library.csproj" />
    <ProjectReference Include="..\TorrentFlow.Media\TorrentFlow.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TorrentFlow.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <WebBuildInputs Include="$(WebProjectDirectory)**\*"
                    Exclude="$(WebProjectDirectory)node_modules\**;$(WebProjectDirectory)dist\**" />
  </ItemGroup>
  <!-- dotnet test forwards this global property to every project, including API references. -->
  <Target Name="BuildWeb" BeforeTargets="PrepareForBuild"
          Condition="'$(SkipWebBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(VSTestSessionCorrelationId)' == ''"
          Inputs="@(WebBuildInputs);$(MSBuildProjectFullPath)"
          Outputs="$(WebProjectDirectory)dist\index.html">
    <Exec Command="where pnpm &gt;nul 2&gt;nul" Condition="'$(OS)' == 'Windows_NT'" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="PnpmCheckExitCode" />
    </Exec>
    <Exec Command="command -v pnpm &gt;/dev/null 2&gt;&amp;1" Condition="'$(OS)' != 'Windows_NT'" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="PnpmCheckExitCode" />
    </Exec>
    <Error Condition="'$(PnpmCheckExitCode)' != '0'"
           Text="pnpm is required to build TorrentFlow's web UI. Install Node.js, then run 'npm i -g pnpm' (or 'corepack enable' if Corepack is installed), reopen your terminal, and retry. Backend-only builds can use -p:SkipWebBuild=true." />
    <Message Importance="high" Text="Building TorrentFlow web UI (pnpm install --frozen-lockfile + pnpm build)..." />
    <Exec WorkingDirectory="$(WebProjectDirectory)" Command="pnpm install --frozen-lockfile" />
    <Exec WorkingDirectory="$(WebProjectDirectory)" Command="pnpm build" />
  </Target>
  <Target Name="PublishWeb" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildWeb">
    <Error Condition="!Exists('$(WebProjectDirectory)dist\index.html')"
           Text="web/dist is missing. Publish without SkipWebBuild, or run 'pnpm --dir web install --frozen-lockfile' and 'pnpm --dir web build' first." />
    <ItemGroup>
      <WebDistFiles Include="$(WebProjectDirectory)dist\**\*" />
      <ResolvedFileToPublish Include="@(WebDistFiles->'%(FullPath)')">
        <RelativePath>wwwroot\%(WebDistFiles.RecursiveDir)%(WebDistFiles.Filename)%(WebDistFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
